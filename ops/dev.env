# Dev environment for local HTTPS + passkey testing.
# Usage: `make dev-run`  (sources this file then runs the server).
#
# Expects mkcert-installed certs at ops/dev-certs/deadman.local*.pem and
# `127.0.0.1 deadman.local` in /etc/hosts.

export DEADMAN_ENV=dev
export DEADMAN_LISTEN_ADDR=:8443
export DEADMAN_DATABASE_URL="postgres://deadman:deadman@localhost:5432/deadman?sslmode=disable"

# Object storage (local MinIO stack).
export DEADMAN_S3_PRIMARY_ENDPOINT=http://localhost:9000
export DEADMAN_S3_BACKUP_ENDPOINT=http://localhost:9010
export DEADMAN_S3_ACCESS_KEY=deadman
export DEADMAN_S3_SECRET_KEY=deadmandeadman

# TLS + WebAuthn RP config. TLS + a real-looking RP ID is required by
# passkey managers like Bitwarden / MS Authenticator; they refuse `localhost`.
export DEADMAN_TLS_CERT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/ops/dev-certs/deadman.local.pem"
export DEADMAN_TLS_KEY="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/ops/dev-certs/deadman.local-key.pem"
export DEADMAN_RP_ID=deadman.local
export DEADMAN_RP_ORIGINS=https://deadman.local:8443

# Threshold vault. Two passphrases are REQUIRED — one per custodian. For
# dev, pick two arbitrary strings (they won't be rotated often in dev,
# so just set them once and leave them).
# On first boot, the server prints the offline recovery share (share 3)
# to stderr — scroll back and record it if you care about dev recovery.
#
# Remove DEADMAN_LEGACY_SINGLE_KEY and set both passphrases for
# threshold mode (default after M5):
export DEADMAN_VAULT_PASSPHRASE_A="dev-phrase-alpha-change-me"
export DEADMAN_VAULT_PASSPHRASE_B="dev-phrase-beta-change-me"
# export DEADMAN_VAULT_PATH="$(pwd)/control/release-vault.json"
#
# Legacy single-key mode — only for migration windows:
# export DEADMAN_LEGACY_SINGLE_KEY=true

# SMTP for the "email" destination kind. Uncomment and fill in to enable.
# For smoke-testing without a real SMTP server, run mailhog locally:
#   docker run -d --name mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   open http://localhost:8025 to see delivered mail, nothing leaves your box.
# export DEADMAN_SMTP_HOST=localhost
# export DEADMAN_SMTP_PORT=1025
# export DEADMAN_SMTP_FROM='Deadman <noreply@deadman.local>'
# export DEADMAN_SMTP_INSECURE_SKIP_VERIFY=true  # mailhog has no TLS
#
# For a real SMTP account (Fastmail / SES / Postmark / etc.):
# export DEADMAN_SMTP_HOST=smtp.example.org
# export DEADMAN_SMTP_PORT=587
# export DEADMAN_SMTP_USERNAME=deadman@example.org
# export DEADMAN_SMTP_PASSWORD=...
# export DEADMAN_SMTP_FROM='Deadman <noreply@example.org>'
