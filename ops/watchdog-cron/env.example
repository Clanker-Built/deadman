# /etc/deadman-watchdog/env  —  read by watchdog-poll.sh on each cron firing.
# Mode 0640, owned by the user that runs the cron.

# Onion URL of the control plane (no trailing slash).
WATCHDOG_ONION_URL=http://CHANGE_ME.onion

# Pinned Ed25519 service public key, base64url-unpadded. Get this ONCE from
# a fresh install via:
#   curl http://YOUR.onion/watchdog | jq -r .service_pubkey
# Pin this value here. If it ever needs to change (key rotation), the new
# value should be communicated out-of-band and verified manually before
# rotating the watchdog config.
WATCHDOG_SERVICE_PUBKEY_B64URL=

# Tolerated staleness. Match to ~3× scheduler interval (default 30s) with
# a floor of 90s. 300 (5 min) is a reasonable default.
STALE_THRESHOLD_SECONDS=300

# Tor SOCKS proxy on this host. Default for system-tor on Debian.
TOR_SOCKS=127.0.0.1:9050

# Where to send alerts. Any URL that accepts POST with JSON body. Examples:
#   - Pushover: https://api.pushover.net/1/messages.json (with PAYLOAD munging)
#   - Slack incoming webhook: https://hooks.slack.com/services/...
#   - PagerDuty Events v2: https://events.pagerduty.com/v2/enqueue
#   - Your own ntfy.sh topic: https://ntfy.sh/your-topic
ALERT_URL=

# Optional shared secret echoed in X-Watchdog-Secret header, so the alert
# receiver can authenticate.
ALERT_SHARED_SECRET=
