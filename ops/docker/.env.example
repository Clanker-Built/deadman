# Compose-stack credentials. scripts/setup-onion.sh generates the real
# .env from random secrets at install time. Do NOT commit a populated
# .env to a public repo.
#
# These are referenced by docker-compose.yml as ${VAR}.
POSTGRES_USER=deadman
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=deadman
MINIO_ROOT_USER=deadman
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
