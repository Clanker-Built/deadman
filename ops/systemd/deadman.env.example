# /etc/deadman/deadman.env  —  installed mode 0600, owned by deadman:deadman.
# This is the production config consumed by the systemd unit.
# DO NOT commit a real version of this file with secrets to a git repo.

DEADMAN_ENV=prod

# Bind on loopback only. Tor's hidden service forwards :80 → 127.0.0.1:8080.
DEADMAN_LISTEN_ADDR=127.0.0.1:8080

# Database. Local Postgres in docker-compose by default; replace with your
# managed-Postgres URL if you point at one.
DEADMAN_DATABASE_URL=postgres://deadman:CHANGE_ME@127.0.0.1:5432/deadman?sslmode=disable

# Object storage. Local MinIO defaults; replace with R2/B2/S3 etc. for prod.
DEADMAN_S3_PRIMARY_ENDPOINT=http://127.0.0.1:9000
DEADMAN_S3_BACKUP_ENDPOINT=http://127.0.0.1:9010
DEADMAN_S3_ACCESS_KEY=deadman
DEADMAN_S3_SECRET_KEY=CHANGE_ME

# WebAuthn relying-party config. Filled in by the setup script after Tor
# generates the .onion address. v3 onions are valid "secure contexts" so
# WebAuthn works over plain HTTP through Tor.
DEADMAN_RP_ID=REPLACE_WITH_YOUR.onion
DEADMAN_RP_ORIGINS=http://REPLACE_WITH_YOUR.onion

# State paths. Default to /var/lib/deadman/.
DEADMAN_VAULT_PATH=/var/lib/deadman/release-vault.json
DEADMAN_SERVICE_SIGNING_KEY_PATH=/var/lib/deadman/service-signing-key.bin

# Threshold vault passphrases. REQUIRED. The server prints share 3 once on
# first boot — record it offline and store in a safe.
DEADMAN_VAULT_PASSPHRASE_A=CHANGE_ME_TO_A_LONG_RANDOM_STRING_A
DEADMAN_VAULT_PASSPHRASE_B=CHANGE_ME_TO_A_LONG_RANDOM_STRING_B

# First-login auto-promote-to-admin email. Idempotent; ignored after any
# admin exists. Leave blank in steady-state.
DEADMAN_BOOTSTRAP_ADMIN_EMAIL=

# Backup retention (admin-triggered pg_dump snapshots).
DEADMAN_BACKUP_KEEP_COUNT=14

# Optional SMTP fallback. Admin-panel-saved settings (DB) override these on
# restart. The password remains env-only unless you save a vault-wrapped
# version via the admin panel.
# DEADMAN_SMTP_HOST=
# DEADMAN_SMTP_PORT=587
# DEADMAN_SMTP_USERNAME=
# DEADMAN_SMTP_PASSWORD=
# DEADMAN_SMTP_FROM=
