DEADMAN_ENV=dev
DEADMAN_LISTEN_ADDR=:8080
DEADMAN_DATABASE_URL=postgres://deadman:deadman@localhost:5432/deadman?sslmode=disable

# Object storage (local MinIO by default)
DEADMAN_S3_PRIMARY_ENDPOINT=http://localhost:9000
DEADMAN_S3_PRIMARY_BUCKET=deadman-primary
DEADMAN_S3_BACKUP_ENDPOINT=http://localhost:9010
DEADMAN_S3_BACKUP_BUCKET=deadman-backup
DEADMAN_S3_ACCESS_KEY=deadman
DEADMAN_S3_SECRET_KEY=deadmandeadman

# TLS (required for passkey managers like Bitwarden / MS Authenticator —
# they refuse to save passkeys for RP IDs on http://localhost).
# Generate with mkcert: see README.
# DEADMAN_TLS_CERT=./ops/dev-certs/deadman.local.pem
# DEADMAN_TLS_KEY=./ops/dev-certs/deadman.local-key.pem
# DEADMAN_RP_ID=deadman.local
# DEADMAN_RP_ORIGINS=https://deadman.local:8443
# DEADMAN_LISTEN_ADDR=:8443
